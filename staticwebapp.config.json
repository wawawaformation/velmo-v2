{
  "routes": [
    {
      "route": "/assets/*",
      "serve": "/assets/*"
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{css,svg,gif,ico,jpg,jpeg,png,woff,woff2}"]
  },
  "mimeTypes": {
    ".json": "text/json"
  }
}
