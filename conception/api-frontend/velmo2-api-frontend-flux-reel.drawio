        </mxCell>
        <mxCell id="app_vue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="App.vue&#xa;(Vue 3 + Vite + Sass)" vertex="1">
          <mxGeometry height="60" width="200" x="140" y="80" as="geometry" />
        </mxCell>
        <mxCell id="e_actor_app" edge="1" parent="1" source="actor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" target="app_vue" value="saisit un message,&#xa;choisit un client">
