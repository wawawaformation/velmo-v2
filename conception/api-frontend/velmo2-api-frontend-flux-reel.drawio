        </mxCell>
        <mxCell id="app_nav" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="AppNav.vue&#xa;dropdown profil&#xa;→ update:selectedUserId" vertex="1">
          <mxGeometry height="60" width="180" x="140" y="180" as="geometry" />
