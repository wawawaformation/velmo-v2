        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" value="API REST / Frontend Vue.js — flux réel implémenté (src/velmo/api.py, frontend/)" vertex="1">
