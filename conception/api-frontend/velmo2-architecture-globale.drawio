<mxfile host="Electron">
  <diagram name="Architecture globale" id="architecture-globale">
    <mxGraphModel dx="2066" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="Velmo 2.0 — Architecture globale (CLI + API + Frontend)" vertex="1">
          <mxGeometry height="40" width="1200" x="20" y="10" as="geometry" />
        </mxCell>

        <!-- INTERFACES -->
        <mxCell id="layer_input" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#e8f4f8;" value="INTERFACES UTILISATEUR" vertex="1">
          <mxGeometry height="20" width="500" x="20" y="70" as="geometry" />
        </mxCell>

        <mxCell id="cli_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor:#6c8ebf;fontSize=10;" value="CLI (cli.py)&#xa;REPL conversationnel" vertex="1">
          <mxGeometry height="60" width="200" x="40" y="100" as="geometry" />
        </mxCell>

        <mxCell id="api_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#dae8fc;strokeColor:#6c8ebf;fontSize=10;" value="API REST (api.py)&#xa;FastAPI, uvicorn" vertex="1">
          <mxGeometry height="60" width="200" x="320" y="100" as="geometry" />
        </mxCell>

        <mxCell id="frontend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor:#82b366;fontSize=10;" value="Frontend (frontend/)&#xa;Vue 3 + Vite + Sass" vertex="1">
          <mxGeometry height="60" width="200" x="600" y="100" as="geometry" />
        </mxCell>

        <!-- NOYAU AGENT -->
        <mxCell id="layer_core" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#fffff0;" value="NOYAU PARTAGÉ" vertex="1">
          <mxGeometry height="20" width="500" x="20" y="200" as="geometry" />
        </mxCell>

        <mxCell id="agent_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor:#d6b656;fontSize=10;" value="Agent (agent.py)&#xa;create_agent() + LangGraph&#xa;GuardrailMiddleware&#xa;MemoryMiddleware" vertex="1">
          <mxGeometry height="80" width="280" x="240" y="230" as="geometry" />
        </mxCell>

        <!-- Flèches vers agent -->
        <mxCell id="e_cli_agent" edge="1" parent="1" source="cli_box" target="agent_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_api_agent" edge="1" parent="1" source="api_box" target="agent_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_frontend_api" edge="1" parent="1" source="frontend_box" target="api_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" value="HTTP fetch()">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="160" />
              <mxPoint x="420" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- SOUS-SYSTÈMES PARTAGÉS -->
        <mxCell id="layer_subsys" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#ffe8e8;" value="SOUS-SYSTÈMES PARTAGÉS" vertex="1">
          <mxGeometry height="20" width="500" x="20" y="340" as="geometry" />
        </mxCell>

        <mxCell id="guardrails_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor:#b85450;fontSize=9;" value="Guardrails&#xa;moderation.py&#xa;content_safety.py&#xa;moderation_llm.py&#xa;__init__.py" vertex="1">
          <mxGeometry height="80" width="200" x="40" y="370" as="geometry" />
        </mxCell>

        <mxCell id="memory_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#f8cecc;strokeColor:#b85450;fontSize=9;" value="Mémoire&#xa;__init__.py&#xa;middleware.py&#xa;consolidation.py&#xa;episodic.py" vertex="1">
          <mxGeometry height="80" width="200" x="310" y="370" as="geometry" />
        </mxCell>

        <mxCell id="tools_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#f8cecc;strokeColor:#b85450;fontSize=9;" value="Outils métier&#xa;binding.py&#xa;get_order.py&#xa;cancel_order.py&#xa;check_stock.py" vertex="1">
          <mxGeometry height="80" width="200" x="580" y="370" as="geometry" />
        </mxCell>

        <mxCell id="llm_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#f8cecc;strokeColor:#b85450;fontSize=9;" value="LLM&#xa;llm.py&#xa;get_chat_model()&#xa;get_classifier_llm()&#xa;LatencyCallbackHandler" vertex="1">
          <mxGeometry height="80" width="200" x="850" y="370" as="geometry" />
        </mxCell>

        <mxCell id="db_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor:#f8cecc;strokeColor:#b85450;fontSize=9;" value="Persistance&#xa;db.py (SQLAlchemy)&#xa;kb_store.py (Chroma)&#xa;sampledata.py" vertex="1">
          <mxGeometry height="80" width="200" x="1120" y="370" as="geometry" />
        </mxCell>

        <!-- Flèches du agent vers sous-systèmes -->
        <mxCell id="e_agent_guardrails" edge="1" parent="1" source="agent_box" target="guardrails_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=8;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_agent_memory" edge="1" parent="1" source="agent_box" target="memory_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=8;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_agent_tools" edge="1" parent="1" source="agent_box" target="tools_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=8;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_agent_llm" edge="1" parent="1" source="agent_box" target="llm_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=8;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="310" />
              <mxPoint x="950" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_agent_db" edge="1" parent="1" source="agent_box" target="db_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=8;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="310" />
              <mxPoint x="1220" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- LÉGENDE -->
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=9;fillColor=#f5f5f5;strokeColor=#999999;" value="&lt;b&gt;Points clés :&lt;/b&gt;&#xa;• CLI et API réutilisent le MÊME Agent (agent.py) — aucune duplication de logique métier&#xa;• Frontend consomme l'API REST (aucune logique métier côté client)&#xa;• Tous les sous-systèmes (garde-fous, mémoire, outils, LLM, persistance) sont PARTAGÉS&#xa;• Agent.respond(user_id, message) → str → reste du flow identique CLI/API&#xa;• Flèches pleines : contrôle direct ; flèches pointillées : dépendances réutilisées" vertex="1">
          <mxGeometry height="90" width="1300" x="40" y="1220" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
