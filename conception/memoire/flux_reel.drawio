<mxfile host="Electron">
  <diagram name="Flux réel" id="flux-reel-memoire">
    <mxGraphModel dx="2066" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" value="Mémoire Velmo — flux réel implémenté (src/velmo/memory/)" vertex="1">
          <mxGeometry height="30" width="700" x="20" y="10" as="geometry" />
        </mxCell>

        <!-- Acteur -->
        <mxCell id="actor" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Client" vertex="1">
          <mxGeometry height="60" width="30" x="40" y="70" as="geometry" />
        </mxCell>

        <mxCell id="agent" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Agent.respond()" vertex="1">
          <mxGeometry height="60" width="140" x="140" y="70" as="geometry" />
        </mxCell>
        <mxCell id="e_actor_agent" edge="1" parent="1" source="actor" target="agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="message">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- write() -->
        <mxCell id="write" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="MemoryManager.write(user_id, msg, réponse)" vertex="1">
          <mxGeometry height="60" width="220" x="340" y="70" as="geometry" />
        </mxCell>
        <mxCell id="e_agent_write" edge="1" parent="1" source="agent" target="write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="après réponse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Court terme RAM -->
        <mxCell id="short_term" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="short_term.py&#xa;dict RAM {user_id: [turns]}&#xa;— fil complet, aucune troncature —" vertex="1">
          <mxGeometry height="70" width="220" x="640" y="40" as="geometry" />
        </mxCell>
        <mxCell id="e_write_short" edge="1" parent="1" source="write" target="short_term" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="append(user, role, contenu)&#xa;x2 (user + assistant)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Buffer MessageBrut -->
        <mxCell id="buffer" parent="1" style="shape=dataStorage;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="Table MessageBrut&#xa;(capture synchrone)" vertex="1">
          <mxGeometry height="80" width="220" x="330" y="195" as="geometry" />
        </mxCell>
        <mxCell id="e_write_buffer" edge="1" parent="1" source="write" target="buffer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="buffer.capture()&#xa;(message user seul)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Scheduler périodique réel (APScheduler) -->
        <mxCell id="scheduler_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="memory/scheduler.py — APScheduler&#xa;BackgroundScheduler, interval (60s par défaut)&#xa;démarré dans cli.py au lancement du process&#xa;→ run_pending_job_all_users() à chaque tick&#xa;→ mm.close() en fin de tick (libère la connexion)" vertex="1">
          <mxGeometry height="100" width="280" x="20" y="290" as="geometry" />
        </mxCell>
        <mxCell id="job_trigger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" value="run_pending_job(user_id) [explicite, ex. tests]&#xa;run_pending_job_all_users() [scheduler, tous users]" vertex="1">
          <mxGeometry height="50" width="280" x="20" y="400" as="geometry" />
        </mxCell>
        <mxCell id="e_scheduler_jobtrigger" edge="1" parent="1" source="scheduler_box" target="job_trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" value="tick →">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="processor" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="processor.process_pending(user_id)&#xa;(par utilisateur, isolation R3)" vertex="1">
          <mxGeometry height="60" width="260" x="330" y="320" as="geometry" />
        </mxCell>
        <mxCell id="e_job_processor" edge="1" parent="1" source="job_trigger" target="processor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="appelle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_buffer_processor" edge="1" parent="1" source="buffer" target="processor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" value="pending_for(user_id)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Classifier -->
        <mxCell id="classifier" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="classifier.classify_and_distill(contenu, llm)&#xa;LLM dédié (Phi-4-mini-instruct) → liste de faits (JSON)&#xa;validation de plausibilité par clé connue&#xa;(rejette les extractions incohérentes, ex. année classée pointure)&#xa;repli règles regex déterministes si LLM absent/échec" vertex="1">
          <mxGeometry height="100" width="300" x="630" y="310" as="geometry" />
        </mxCell>
        <mxCell id="e_processor_classifier" edge="1" parent="1" source="processor" target="classifier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="pour chaque ligne">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Décision destination -->
        <mxCell id="dest_dec" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fontSize=10;" value="destination ?" vertex="1">
          <mxGeometry height="90" width="100" x="670" y="440" as="geometry" />
        </mxCell>
        <mxCell id="e_classifier_dec" edge="1" parent="1" source="classifier" target="dest_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3 destinations -->
        <mxCell id="d_column" parent="1" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="MemoryUser (colonne)&#xa;semantic.set_known_fact()&#xa;pointure/segment/tutoiement/&#xa;langue/canal_contact" vertex="1">
          <mxGeometry height="80" width="180" x="360" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e_dec_column" edge="1" parent="1" source="dest_dec" target="d_column" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="semantic_column&#xa;(clé connue)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="d_vector" parent="1" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" value="Vector/Fact store&#xa;vector_store.get_fact_store()&#xa;Chroma si dispo,&#xa;sinon MemoryFact (relationnel)" vertex="1">
          <mxGeometry height="90" width="220" x="610" y="580" as="geometry" />
        </mxCell>
        <mxCell id="e_dec_vector" edge="1" parent="1" source="dest_dec" target="d_vector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="semantic_vector&#xa;(clé imprévisible)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="d_episode" parent="1" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="MemoryEpisode&#xa;episodic.add_episode()&#xa;(nettoyage léger, LIKE)" vertex="1">
          <mxGeometry height="70" width="180" x="880" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e_dec_episode" edge="1" parent="1" source="dest_dec" target="d_episode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="episodic&#xa;(événement daté)">
          <mxGeometry relative="1" x="-0.3" as="geometry" />
        </mxCell>

        <mxCell id="d_none" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" value="rien à retenir&#xa;(pas d'écriture)" vertex="1">
          <mxGeometry height="50" width="140" x="1080" y="440" as="geometry" />
        </mxCell>
        <mxCell id="e_dec_none" edge="1" parent="1" source="dest_dec" target="d_none" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.2;exitDx=0;exitDy=0;" value="none">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Purge buffer après traitement -->
        <mxCell id="e_dec_purge" edge="1" parent="1" source="processor" target="buffer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#4D4D4D;fontColor=#4D4D4D;fontSize=9;exitX=0;exitY=0.3;entryX=0;entryY=0.9;" value="buffer.delete(rows)&#xa;après routage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- remember_fact (raccourci direct) -->
        <mxCell id="remember" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="MemoryManager.remember_fact(user_id, key, value)&#xa;— raccourci DIRECT, sans passer par le buffer —" vertex="1">
          <mxGeometry height="60" width="300" x="40" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e_remember_column" edge="1" parent="1" source="remember" target="d_column" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="si key connue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_remember_vector" edge="1" parent="1" source="remember" target="d_vector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" value="sinon">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="700" />
              <mxPoint x="190" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- read() -->
        <mxCell id="read_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Lecture — MemoryManager.read(user_id, message)" vertex="1">
          <mxGeometry height="24" width="500" x="40" y="810" as="geometry" />
        </mxCell>

        <mxCell id="read" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="read()" vertex="1">
          <mxGeometry height="50" width="120" x="40" y="860" as="geometry" />
        </mxCell>
        <mxCell id="r_short" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="short_term.get_turns(user_id)&#xa;→ history" vertex="1">
          <mxGeometry height="50" width="200" x="220" y="800" as="geometry" />
        </mxCell>
        <mxCell id="r_column" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="semantic.get_known_facts(user_id)&#xa;→ facts" vertex="1">
          <mxGeometry height="50" width="200" x="220" y="860" as="geometry" />
        </mxCell>
        <mxCell id="r_vector" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="store.search(user_id, message)&#xa;→ episodic (vecteur)" vertex="1">
          <mxGeometry height="50" width="200" x="220" y="920" as="geometry" />
        </mxCell>
        <mxCell id="r_episode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="episodic.search_episodes(user_id, message)&#xa;→ episodic (mots-clés)" vertex="1">
          <mxGeometry height="50" width="200" x="220" y="980" as="geometry" />
        </mxCell>
        <mxCell id="e_read_short" edge="1" parent="1" source="read" target="r_short" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_read_column" edge="1" parent="1" source="read" target="r_column" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_read_vector" edge="1" parent="1" source="read" target="r_vector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_read_episode" edge="1" parent="1" source="read" target="r_episode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ctx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="MemoryContext&#xa;(history + facts + episodic)&#xa;.render() → texte injecté au prompt LLM" vertex="1">
          <mxGeometry height="70" width="260" x="500" y="910" as="geometry" />
        </mxCell>
        <mxCell id="e_r_short_ctx" edge="1" parent="1" source="r_short" target="ctx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_r_column_ctx" edge="1" parent="1" source="r_column" target="ctx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_r_vector_ctx" edge="1" parent="1" source="r_vector" target="ctx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_r_episode_ctx" edge="1" parent="1" source="r_episode" target="ctx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- forget() -->
        <mxCell id="forget_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Oubli (R5) — MemoryManager.forget(user_id, target)" vertex="1">
          <mxGeometry height="24" width="500" x="40" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="forget" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="forget()&#xa;purge TOUS les emplacements" vertex="1">
          <mxGeometry height="50" width="220" x="40" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="short_term.purge_matching()" vertex="1">
          <mxGeometry height="40" width="200" x="320" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="semantic.clear_matching()" vertex="1">
          <mxGeometry height="40" width="200" x="320" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="store.delete_matching()" vertex="1">
          <mxGeometry height="40" width="200" x="320" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="episodic.delete_matching()" vertex="1">
          <mxGeometry height="40" width="200" x="320" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="f5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="buffer.delete_matching()&#xa;(fenêtre de risque, si pas encore traité)" vertex="1">
          <mxGeometry height="50" width="220" x="320" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="e_forget_f1" edge="1" parent="1" source="forget" target="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_forget_f2" edge="1" parent="1" source="forget" target="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_forget_f3" edge="1" parent="1" source="forget" target="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_forget_f4" edge="1" parent="1" source="forget" target="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_forget_f5" edge="1" parent="1" source="forget" target="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Légende écarts vs conception -->
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Écarts assumés vs conception (choix.md) :&lt;/b&gt;&#xa;• write() fait UNIQUEMENT la capture synchrone (MessageBrut). Le traitement est déclenché par un vrai scheduler périodique (memory/scheduler.py, APScheduler, tick toutes les 60s par défaut), démarré dans cli.py — conforme à choix.md. Les tests appellent run_pending_job(user_id) directement (pas d'attente réelle en suite de tests).&#xa;• Classification par LLM dédié (Phi-4-mini-instruct, AZURE_AI_CLASSIFIER_MODEL) — extrait plusieurs faits par message (JSON), avec validation de plausibilité par clé connue et repli sur des règles regex déterministes si le LLM est absent ou échoue (garantit un fonctionnement 100% hors-ligne en CI, sans réseau/extras).&#xa;• Store sémantique « vectoriel » a un repli relationnel MemoryFact (recherche par recouvrement de tokens) si Chroma indisponible.&#xa;• Chaque tick ferme sa session (MemoryManager.close()) pour libérer la connexion au pool Postgres — un oubli ici épuisait le pool et bloquait le scheduler après quelques ticks (bug corrigé)." vertex="1">
          <mxGeometry height="160" width="580" x="600" y="1080" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
