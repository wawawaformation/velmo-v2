        <mxCell id="e_inj_cs" edge="1" parent="1" source="det_injection" target="det_content_safety_in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="si aucun match">
