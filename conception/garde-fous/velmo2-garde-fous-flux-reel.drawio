        <!-- check_output -->
        <mxCell id="check_output" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="GuardrailEngine.check_output(answer)" vertex="1">
          <mxGeometry height="60" width="260" x="600" y="670" as="geometry" />
        </mxCell>
        <mxCell id="e_allow_output" edge="1" parent="1" source="allow_input" target="check_output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" value="réponse générée">
