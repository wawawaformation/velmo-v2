          <mxGeometry height="100" width="260" x="940" y="210" as="geometry" />
        </mxCell>

        <mxCell id="det_scope" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="detect_out_of_scope(message)&#xa;(scope.py, regex)" vertex="1">
          <mxGeometry height="70" width="220" x="1280" y="220" as="geometry" />
