        <mxCell id="e_llm_scope" edge="1" parent="1" source="det_moderation_llm" target="det_scope" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="si aucune catégorie">
