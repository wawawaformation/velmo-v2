        <!-- Chaîne de détecteurs input — règles (1er recours) -->
        <mxCell id="det_moderation_in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="detect_moderation(message)&#xa;hate / violence / sexual&#xa;(moderation.py, regex)" vertex="1">
