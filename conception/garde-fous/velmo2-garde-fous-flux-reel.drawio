        <mxCell id="det_injection" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="detect_prompt_injection(message)&#xa;(prompt_injection.py, regex)" vertex="1">
          <mxGeometry height="70" width="220" x="330" y="220" as="geometry" />
